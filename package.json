{
  "name": "integration_deckcraft",
  "version": "0.1.3",
  "private": true,
  "description": "Edit PowerPoint presentations in Nextcloud with DeckCraft",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
